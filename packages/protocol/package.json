{
  "name": "@kvitok/protocol",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Support Action Protocol: schemas, request signing, client and conformance checks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "protocol-conformance": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup src/cli.ts --format esm",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "conformance": "node dist/cli.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
