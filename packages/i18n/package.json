{
  "name": "@kvitok/i18n",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Translation catalogs shared by the API and the web UI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/compile-locales.mjs && tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "node scripts/compile-locales.mjs && tsc --noEmit",
    "test": "node scripts/compile-locales.mjs && vitest run"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "^2.8.1"
  }
}
