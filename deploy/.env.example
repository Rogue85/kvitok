# Copy to .env next to docker-compose.yml and fill in. Guide: docs/deployment.md

# Bundled services to run: postgres, redis, caddy (HTTPS). Remove one to use your own:
# an external database (set DATABASE_URL), an external Redis (set REDIS_URL), your own reverse proxy.
COMPOSE_PROFILES=postgres,redis

# Image version. Pin a release (e.g. 0.3.1) in production; latest is the newest release.
KVITOK_VERSION=latest

# Secret for signing cookies and other HMACs, at least 32 characters: openssl rand -hex 32
APP_SECRET=

# Interface language of the installation: en or ru.
APP_LOCALE=en

# --- Database ---------------------------------------------------------------
# Bundled Postgres: its password (letters and digits, it goes into a URL): openssl rand -hex 16
POSTGRES_PASSWORD=
# External Postgres 15+ instead: remove postgres from COMPOSE_PROFILES and set the URL.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/kvitok

# --- Redis ------------------------------------------------------------------
# External Redis 7+ instead of the bundled one: remove redis from COMPOSE_PROFILES and set the URL.
# It must not evict keys: maxmemory-policy noeviction.
# REDIS_URL=redis://:password@redis.example.com:6379

# --- Access -----------------------------------------------------------------
# Where the app listens on this host. The default is for a reverse proxy on the same host.
# Without a proxy, open it to the network: KVITOK_LISTEN=80 (or 0.0.0.0:3000).
# KVITOK_LISTEN=127.0.0.1:3000

# Bundled Caddy (add caddy to COMPOSE_PROFILES): the domain gets a Let's Encrypt certificate.
# Its DNS record must point to this host, ports 80 and 443 must be open.
# http://support.example.com or :80 serves plain HTTP without a certificate.
# DOMAIN=support.example.com

# --- Optional ---------------------------------------------------------------
# Secure session cookie: auto (by the request protocol, X-Forwarded-Proto behind a proxy), true or false.
# COOKIE_SECURE=auto
# Session lifetime in days.
# SESSION_TTL_DAYS=30
# Sign-in attempts per minute from one IP.
# LOGIN_RATE_LIMIT=10
# Mailbox polling interval, seconds.
# MAIL_POLL_SECONDS=60
# Migrations on start of the app container; false when they run separately (docker compose run --rm kvitok migrate).
# MIGRATE_ON_START=true
