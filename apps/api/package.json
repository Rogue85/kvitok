{
  "name": "@kvitok/api",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch --config nest-cli.dev.json",
    "dev:worker": "nest start --watch --config nest-cli.worker.json --entryFile worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "pnpm build && node dist/cli.js seed:dev",
    "fake-llm": "node scripts/fake-llm.mjs",
    "eval": "nest build && node dist/eval.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "@kvitok/i18n": "workspace:*",
    "@kvitok/protocol": "workspace:*",
    "@kvitok/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5.81.5",
    "dotenv": "^18.0.9",
    "email-reply-parser": "^2.3.9",
    "fastify": "5.11.3",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.10.0",
    "ioredis": "5.11.1",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kvitok/coffee-sim": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "pg": "^8.23.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
