NODE_ENV=development
PORT=3001
# Interface language of the installation: en or ru. The UI, API messages and system texts follow it.
APP_LOCALE=en
DATABASE_URL=postgresql://kvitok:kvitok@localhost:5432/kvitok
REDIS_URL=redis://localhost:6379
# Secret for signing cookies and other HMACs. At least 32 characters.
APP_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL_DAYS=30
# Secure session cookie: auto (by the request protocol, X-Forwarded-Proto behind a proxy), true or false.
COOKIE_SECURE=auto
WEB_ORIGIN=http://localhost:3000
# Web push keys; without them they are generated on first use and stored in the database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
